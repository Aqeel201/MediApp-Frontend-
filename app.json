{
  "expo": {
    "name": "MediApp",
    "slug": "MediApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/LogoBGR.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/LogoBGR.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/LogoBGR.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.aqee.MediApp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "2b8d1db2-8612-4750-b30e-4ef8f7a338a1"
      }
    },
    "plugins": [
      "expo-audio",
      "expo-video",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.aqee.MediApp",
          "enableGooglePay": true
        }
      ]
    ]
  }
}